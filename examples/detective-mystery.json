{
  "metadata": {
    "id": "detective-mystery-001",
    "title": "The Vanishing Heiress",
    "description": "You are a private detective called to investigate the disappearance of Eleanor Ashworth, heir to the Ashworth fortune. The family's dark secrets may hold the key to finding her—or explain why she wanted to vanish.",
    "author": "Example Author",
    "version": "1.0.0",
    "tags": ["mystery", "noir", "detective"]
  },
  "characters": [
    {
      "id": "victoria",
      "name": "Victoria Ashworth",
      "description": "The family matriarch, elegant but cold. She hired you but seems to be hiding something.",
      "personality": "Calculating, aristocratic, guarded. Speaks in measured tones with an underlying threat.",
      "traits": ["manipulative", "wealthy", "secretive", "desperate"],
      "initialRelationship": 20
    },
    {
      "id": "marcus",
      "name": "Marcus Ashworth",
      "description": "Eleanor's brother, nervous and fidgety. He stands to inherit if she's declared dead.",
      "personality": "Anxious, defensive, prone to outbursts. Clearly stressed but unclear if from grief or guilt.",
      "traits": ["nervous", "ambitious", "jealous", "conflicted"],
      "initialRelationship": 0
    },
    {
      "id": "catherine",
      "name": "Catherine Mills",
      "description": "Eleanor's personal assistant and closest confidante. Loyal but knows too much.",
      "personality": "Professional, observant, protective of Eleanor's memory. More open when alone.",
      "traits": ["loyal", "observant", "cautious", "grieving"],
      "initialRelationship": 10
    },
    {
      "id": "james",
      "name": "Detective James Harlow",
      "description": "The police detective on the case. Territorial but respects competence.",
      "personality": "Gruff, experienced, by-the-book. Skeptical of private investigators but fair.",
      "traits": ["professional", "skeptical", "thorough", "pragmatic"],
      "initialRelationship": -10
    }
  ],

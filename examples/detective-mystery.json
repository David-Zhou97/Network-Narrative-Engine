  "nodes": [
    {
      "id": "entry_mansion",
      "type": "entry",
      "title": "The Ashworth Mansion",
      "preview": "Begin at the family estate where Eleanor was last seen.",
      "description": "The Ashworth mansion looms before you, its Victorian architecture casting long shadows in the afternoon light. Victoria Ashworth waits at the entrance, her expression unreadable.",
      "characters": ["victoria"],
      "context": {
        "location": "Ashworth Mansion - Front Entrance",
        "mood": "tense",
        "timeOfDay": "afternoon"
      }
    },
    {
      "id": "entry_office",
      "type": "entry",
      "title": "Your Office",
      "preview": "Begin when Catherine Mills visits you seeking help.",
      "description": "Catherine Mills sits across from your desk, clutching a folder of documents. She glances at the door nervously before speaking in hushed tones about her missing employer.",
      "characters": ["catherine"],
      "context": {
        "location": "Your Private Office",
        "mood": "secretive",
        "timeOfDay": "evening"
      }
    },
    {
      "id": "story_victoria_meeting",
      "type": "story",
      "description": "Victoria leads you into the drawing room. Her demeanor is controlled, but you notice her hands trembling slightly as she pours tea.",
      "beat": "First interview with the matriarch",
      "characters": ["victoria"],
      "context": {
        "location": "Ashworth Mansion - Drawing Room",
        "mood": "interrogative",
        "timeOfDay": "afternoon"
      },
      "dialogue": [
        {
          "characterId": "victoria",
          "text": "I trust you'll be discreet about this matter. The family name must be protected.",
          "emotion": "guarded"
        }
      ]
    },
    {
      "id": "story_eleanor_room",
      "type": "story",
      "description": "Eleanor's room is pristine—too pristine. Someone has cleaned it recently. A faint scent of lavender lingers, and you notice a loose floorboard near the window.",
      "beat": "Searching Eleanor's private quarters",
      "characters": [],
      "context": {
        "location": "Ashworth Mansion - Eleanor's Bedroom",
        "mood": "mysterious",
        "timeOfDay": "afternoon"
      }
    },
    {
      "id": "story_find_diary",
      "type": "story",
      "description": "Beneath the floorboard, you find Eleanor's diary wrapped in silk. The final entries speak of fear, betrayal, and a plan to disappear.",
      "beat": "Discovering the hidden diary",
      "characters": [],
      "context": {
        "location": "Ashworth Mansion - Eleanor's Bedroom",
        "mood": "revelatory",
        "timeOfDay": "afternoon"
      },
      "onEnter": [
        { "type": "set", "target": "flags.found_diary", "value": true },
        { "type": "add", "target": "resources.evidence", "value": 2 },
        { "type": "add", "target": "player.intuition", "value": 10 }
      ]
    },
    {
      "id": "story_marcus_nervous",
      "type": "story",
      "description": "You find Marcus in the library, hastily closing his laptop. Sweat beads on his forehead despite the cool room. He's clearly hiding something.",
      "beat": "Confrontation with the nervous heir",
      "characters": ["marcus"],
      "context": {
        "location": "Ashworth Mansion - Library",
        "mood": "confrontational",
        "timeOfDay": "evening"
      }
    },
    {
      "id": "story_marcus_breaks",
      "type": "story",
      "description": "Marcus's composure crumbles. He admits to knowing Eleanor planned to expose the family's financial crimes—and that someone else knew too.",
      "beat": "Marcus reveals the conspiracy",
      "characters": ["marcus"],
      "context": {
        "location": "Ashworth Mansion - Library",
        "mood": "intense",
        "timeOfDay": "evening"
      },
      "onEnter": [
        { "type": "set", "target": "flags.marcus_confession", "value": true },
        { "type": "add", "target": "resources.evidence", "value": 3 },
        { "type": "add", "target": "character.marcus.relationship", "value": -20 }
      ]
    },
    {
      "id": "story_catherine_secret",
      "type": "story",
      "description": "Catherine meets you in a quiet café. She slides an envelope across the table—photographs and a key to a storage unit. Her hands shake.",
      "beat": "Catherine shares what she knows",
      "characters": ["catherine"],
      "context": {
        "location": "Downtown Café",
        "mood": "clandestine",
        "timeOfDay": "night"
      },
      "onEnter": [
        { "type": "add", "target": "character.catherine.relationship", "value": 15 }
      ]
    },
    {
      "id": "story_harlow_encounter",
      "type": "story",
      "description": "Detective Harlow intercepts you outside the mansion. He's not pleased about a private eye on his case, but he seems genuinely concerned about finding Eleanor.",
      "beat": "Clash with the police",
      "characters": ["james"],
      "context": {
        "location": "Outside Ashworth Mansion",
        "mood": "tense",
        "timeOfDay": "night"
      }
    },
    {
      "id": "story_harlow_alliance",
      "type": "story",
      "description": "After reviewing your evidence, Harlow nods grudgingly. 'Alright, we work together. But I lead.' It's an uneasy alliance, but better than working alone.",
      "beat": "Forming a partnership with the police",
      "characters": ["james"],
      "context": {
        "location": "Police Station",
        "mood": "professional",
        "timeOfDay": "morning"
      },
      "onEnter": [
        { "type": "set", "target": "flags.police_ally", "value": true },
        { "type": "add", "target": "character.james.relationship", "value": 30 }
      ]
    },
    {
      "id": "story_safe_house",
      "type": "story",
      "description": "The storage unit leads to an address on the outskirts of town. A small cabin, lights on inside. Eleanor is alive—but she's not alone.",
      "beat": "Finding Eleanor's hiding place",
      "characters": [],
      "context": {
        "location": "Remote Cabin",
        "mood": "suspenseful",
        "timeOfDay": "night"
      },
      "onEnter": [
        { "type": "set", "target": "flags.found_safe_house", "value": true }
      ]
    },
    {
      "id": "story_victoria_confrontation",
      "type": "story",
      "description": "Victoria's mask finally slips. She admits she knew Eleanor planned to expose the family but claims she only wanted to 'talk sense into her.' Her alibi is crumbling.",
      "beat": "The matriarch is cornered",
      "characters": ["victoria"],
      "context": {
        "location": "Ashworth Mansion - Study",
        "mood": "climactic",
        "timeOfDay": "night"
      },
      "onEnter": [
        { "type": "add", "target": "character.victoria.relationship", "value": -30 }
      ]
    },
    {
      "id": "branch_final",
      "type": "branch",
      "description": "The truth emerges, but the outcome depends on what you've uncovered and who you've allied with.",
      "conditions": [
        {
          "targetNodeId": "ending_justice",
          "conditions": [
            { "type": "flag", "target": "police_ally", "operator": "==", "value": true },
            { "type": "resource", "target": "evidence", "operator": ">=", "value": 5 }
          ]
        },
        {
          "targetNodeId": "ending_escape",
          "conditions": [
            { "type": "flag", "target": "found_safe_house", "operator": "==", "value": true },
            { "type": "relationship", "target": "catherine", "operator": ">=", "value": 30 }
          ]
        },
        {
          "targetNodeId": "ending_buried",
          "conditions": [
            { "type": "relationship", "target": "victoria", "operator": ">=", "value": 0 }
          ]
        },
        {
          "targetNodeId": "ending_cold_case",
          "isDefault": true,
          "conditions": []
        }
      ]
    },
    {
      "id": "ending_justice",
      "type": "ending",
      "endingType": "good",
      "title": "Justice Served",
      "description": "With Harlow's backing and your evidence, the Ashworths face prosecution. Eleanor testifies, and the family's crimes are exposed. Your reputation soars.",
      "epilogue": "The Ashworth fortune crumbles, but Eleanor is free. She sends you a letter months later: 'Thank you for believing the truth mattered.' Your office phone rings more often now. Justice, it seems, is good for business.",
      "context": {
        "location": "Courtroom",
        "mood": "triumphant",
        "timeOfDay": "morning"
      }
    },
    {
      "id": "ending_escape",
      "type": "ending",
      "endingType": "neutral",
      "title": "A New Beginning",
      "description": "You help Eleanor disappear properly—new identity, new life. Catherine joins her. The Ashworths never face justice, but Eleanor is safe.",
      "epilogue": "A postcard arrives months later. No return address, just a photo of a coastal town and two words: 'Thank you.' You file it away with your unsolved cases. Some justice comes in small packages.",
      "context": {
        "location": "Train Station",
        "mood": "bittersweet",
        "timeOfDay": "dawn"
      }
    },
    {
      "id": "ending_buried",
      "type": "ending",
      "endingType": "bad",
      "title": "Secrets Buried Deep",
      "description": "Victoria's influence proves too strong. Evidence disappears, witnesses recant. The case is closed—Eleanor officially 'ran away.' You know the truth but can't prove it.",
      "epilogue": "The check Victoria sends is generous. The threat that accompanies it is not. You cash the check and burn your notes. Some fights aren't worth dying over. But the taste of defeat lingers longer than whiskey.",
      "context": {
        "location": "Your Office",
        "mood": "defeated",
        "timeOfDay": "night"
      }
    },
    {
      "id": "ending_cold_case",
      "type": "ending",
      "endingType": "neutral",
      "title": "The Trail Goes Cold",
      "description": "Without enough evidence or allies, the case stalls. Eleanor remains missing, the family keeps their secrets, and you're left with more questions than answers.",
      "epilogue": "Years later, you still think about the Ashworth case. The file sits in your drawer, never quite closed. Sometimes mysteries don't have endings—just stopping points.",
      "context": {
        "location": "Your Office",
        "mood": "melancholic",
        "timeOfDay": "evening"
      }
    }
  ],

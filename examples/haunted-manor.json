    { "id": "e5", "from": "entry_night", "to": "story_evelyn_interview", "choiceType": "agree", "choiceHint": "Find Evelyn first", "priority": 2 },
    { "id": "e6", "from": "entry_night", "to": "story_library_research", "choiceType": "question", "choiceHint": "Research the manor's history", "priority": 3 },
    { "id": "e7", "from": "story_evelyn_interview", "to": "story_shadow_encounter", "choiceType": "confront", "choiceHint": "Demand to see where it's strongest", "priority": 1 },
    { "id": "e8", "from": "story_evelyn_interview", "to": "story_shadow_encounter", "choiceType": "investigate", "choiceHint": "Set up equipment in the cellar", "priority": 2 },
    { "id": "e9", "from": "story_evelyn_interview", "to": "story_ritual_prep", "choiceType": "agree", "choiceHint": "Prepare defenses based on Evelyn's warnings", "priority": 3 },
    { "id": "e10", "from": "story_library_research", "to": "story_shadow_encounter", "choiceType": "confront", "choiceHint": "Confront the source of evil", "priority": 1 },
    { "id": "e11", "from": "story_library_research", "to": "story_shadow_encounter", "choiceType": "investigate", "choiceHint": "Follow the journal's clues to the cellar", "priority": 2 },
    { "id": "e12", "from": "story_library_research", "to": "story_ritual_prep", "choiceType": "agree", "choiceHint": "Prepare the banishing ritual from the journal", "priority": 3, "conditions": [{ "type": "flag", "target": "knows_tragedy", "operator": "==", "value": true }] },
    { "id": "e13", "from": "story_margaret_contact", "to": "story_shadow_encounter", "choiceType": "confront", "choiceHint": "Follow Margaret to face the darkness", "priority": 1 },
    { "id": "e14", "from": "story_margaret_contact", "to": "story_shadow_encounter", "choiceType": "question", "choiceHint": "Ask Margaret about the shadow", "priority": 2 },
    { "id": "e15", "from": "story_margaret_contact", "to": "story_ritual_prep", "choiceType": "comfort", "choiceHint": "Help Margaret prepare the banishing ritual", "priority": 3 },
    { "id": "e16", "from": "story_shadow_encounter", "to": "story_ritual_prep", "choiceType": "agree", "choiceHint": "Seek help to stop it", "priority": 1 },
    { "id": "e17", "from": "story_shadow_encounter", "to": "branch_final", "choiceType": "refuse", "choiceHint": "Flee while you can", "priority": 2 },
    { "id": "e18", "from": "story_shadow_encounter", "to": "branch_final", "choiceType": "confront", "choiceHint": "Face the shadow with what you have", "priority": 3 },
    { "id": "e19", "from": "story_ritual_prep", "to": "branch_final", "choiceType": "agree", "choiceHint": "Begin the banishing ritual", "priority": 1 },
    { "id": "e20", "from": "story_ritual_prep", "to": "branch_final", "choiceType": "confront", "choiceHint": "Face the shadow alone", "priority": 2, "effects": [{ "type": "set", "target": "flags.margaret_ally", "value": false }] },
    { "id": "e21", "from": "story_ritual_prep", "to": "branch_final", "choiceType": "refuse", "choiceHint": "Abandon the manor", "priority": 3 }
  ]
